{"badge":"About Shelter of Hope","title":"Shelter of Hope — ","titleHighlight":"Sanctuary of Hope","paragraph1":"Established in 2026, Shelter of Hope is a nationwide social impact organization in Bangladesh. We are dedicated to child and women protection, missing child rescue, blood donation networks, legal aid, and humanitarian relief operations.","paragraph2":"Our work is founded on human dignity, social justice, and equality. We believe that every person — especially women and children — deserves a safe, dignified, and opportunity-filled life.","images":{"altCamping":"Children in camping activities","altBeach":"Joyful children on the beach","altBoy":"Smiling student with backpack","altHealthcare":"Healthcare and wellness support","altGirlThumbs":"Smiling student studying","altTablet":"Child engaged in digital learning","altArt":"Children with creative art and hand paints","altChalkboard":"Child learning alphabet on chalkboard","altMeal":"Food and nutrition distribution support","altSuperheroes":"Empowered children dressed as superheroes"},"purpose":{"badge":"Our Purpose","title":"What We Work For","mission":{"badge":"Our Mission","title":"Mission","description":"Standing beside women and children to build a safe, just, and violence-free society, connecting them with essential humanitarian support.","points":{"point1":"Immediate Crisis Response","point2":"Long-term Rehabilitation","point3":"Ensuring Rights & Justice","point4":"Capacity Building"}},"vision":{"badge":"Our Vision","title":"Vision","description":"Building a Bangladesh where every woman and child can thrive in a safe, dignified, and equitable environment.","points":{"point1":"Violence-free Society","point2":"Equal Rights for Women","point3":"Safe Future for Children","point4":"Just & Equitable System"}}},"values":{"badge":"Our Core Values","dignity":{"title":"Human Dignity","description":"Every human being has the right to respect and dignity."},"justice":{"title":"Justice & Fairness","description":"Ensuring a fair and equitable system for everyone in society."},"transparency":{"title":"Transparency","description":"All our actions and operations are open, honest, and accountable."},"empathy":{"title":"Empathy & Compassion","description":"We stand by people in their suffering without judgment."},"innovation":{"title":"Innovation","description":"Finding novel and sustainable solutions to social problems is our path."},"responsibility":{"title":"Social Responsibility","description":"We remain firmly dedicated to our collective responsibility toward society."}},"team":{"badge":"Our Team","title":"Those Who Make the Difference","subtitle":"Our dedicated team works every day to bring positive changes to the lives of women and children.","defaultMember":{"name":"Dr. Farhana Islam","role":"Founder & Executive Director"}},"advisors":{"badge":"Advisory Board","title":"Those Who Guide Our Way","subtitle":"Distinguished experts from various fields provide strategic direction and guidance to our mission.","defaultMember":{"name":"Dr. Farhana Islam","role":"Founder & Executive Director"}}}